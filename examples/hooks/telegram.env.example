# Telegram notification credentials
# Copy this file to ~/.claude/hooks/telegram.env and fill in your values.

TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id

# Optional: seconds of local idle time before notifications are sent (default: 120)
# TELEGRAM_IDLE_THRESHOLD=120

# Optional: space-separated project names to exclude from notifications
# TELEGRAM_EXCLUDED_PROJECTS=project-a project-b
